# op run --env-file=.env.1password -- <terraform command>
# 例: op run --env-file=.env.1password -- terraform apply

# Cloudflare (item: gomi-no-hi-cloudflare)
TF_VAR_cloudflare_api_token=op://Development/gomi-no-hi-cloudflare/api_token
TF_VAR_account_id=op://Development/gomi-no-hi-cloudflare/account_id
TF_VAR_zone_id=op://Development/gomi-no-hi-cloudflare/zone_id

# Cloudflare R2 (Terraform state backend)
AWS_ACCESS_KEY_ID=op://Development/gomi-no-hi-cloudflare/r2_access_key_id
AWS_SECRET_ACCESS_KEY=op://Development/gomi-no-hi-cloudflare/r2_secret_access_key

# VAPID (item: gomi-no-hi-vapid)
TF_VAR_vapid_public_key=op://Development/gomi-no-hi-vapid/public_key
TF_VAR_vapid_private_key=op://Development/gomi-no-hi-vapid/private_key
