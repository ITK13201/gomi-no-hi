# op run --env-file=.env.1password -- <terraform command>
# 例: op run --env-file=.env.1password -- terraform apply

# Cloudflare
TF_VAR_cloudflare_api_token=op://gomi-no-hi/cloudflare/api_token
TF_VAR_account_id=op://gomi-no-hi/cloudflare/account_id
TF_VAR_zone_id=op://gomi-no-hi/cloudflare/zone_id

# Cloudflare R2 (Terraform state backend)
AWS_ACCESS_KEY_ID=op://gomi-no-hi/cloudflare/r2_access_key_id
AWS_SECRET_ACCESS_KEY=op://gomi-no-hi/cloudflare/r2_secret_access_key

# VAPID
TF_VAR_vapid_public_key=op://gomi-no-hi/vapid/public_key
TF_VAR_vapid_private_key=op://gomi-no-hi/vapid/private_key
